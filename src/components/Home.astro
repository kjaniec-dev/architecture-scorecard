---
import Layout from "../layouts/Layout.astro";
import Scorecard from "./Scorecard";
import { getLocale, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { m } = getLocale(lang);
---

<Layout lang={lang}>
  <section class="static-only" aria-labelledby="intro-title">
    <h1 id="intro-title" class="mb-3 text-3xl font-bold tracking-tight sm:text-4xl">
      Architecture &amp; Delivery Scorecard
    </h1>
    <p class="max-w-prose text-lg text-muted-foreground">{m.home.lead}</p>
    <ul class="my-6 grid gap-2">
      {
        m.home.facts.map(([lead, rest]) => (
          <li class="rounded-xl border border-border bg-card px-4 py-3">
            <strong>{lead}</strong> &middot; {rest}
          </li>
        ))
      }
    </ul>
  </section>

  <Scorecard client:only="react" lang={lang} />

  <noscript>
    <p class="rounded-xl bg-muted p-4">{m.home.noscript}</p>
  </noscript>

  <section class="static-only mt-12 border-t border-border pt-6" aria-labelledby="how-title">
    <h2 id="how-title" class="mb-2 text-2xl font-bold">{m.home.howTitle}</h2>
    <dl class="max-w-prose space-y-4">
      {
        m.home.how.map(([term, text]) => (
          <div>
            <dt class="font-bold">{term}</dt>
            <dd class="mt-1 text-muted-foreground">{text}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>
