---
import Layout from "../layouts/Layout.astro";
import Scorecard from "../components/Scorecard";
---

<Layout
  title="Architecture & Delivery Scorecard"
  description="Free, browser-based architecture and delivery health check. Answer 20 questions and get a score per area, your 3 biggest risks and recommendations. No account, no tracking, no AI."
>
  <section class="static-only" aria-labelledby="intro-title">
    <h1 id="intro-title" class="mb-3 text-3xl font-bold tracking-tight sm:text-4xl">
      Architecture &amp; Delivery Scorecard
    </h1>
    <p class="max-w-prose text-lg text-muted-foreground">
      A free, browser-based health check for your system and the way you ship it. Answer 20 questions about
      deployments, monitoring, backups and access to production, and get a score per area, your three biggest risks
      and what to do about them.
    </p>
    <ul class="my-6 grid gap-2">
      {
        [
          ["About 5 minutes", "20 questions in 5 areas"],
          ["Private", "nothing is sent anywhere, it all runs in your browser"],
          ["Rule-based", "no AI, so you can see exactly how the score is built"],
        ].map(([lead, rest]) => (
          <li class="rounded-xl border border-border bg-card px-4 py-3">
            <strong>{lead}</strong> &middot; {rest}
          </li>
        ))
      }
    </ul>
  </section>

  <Scorecard client:only="react" />

  <noscript>
    <p class="rounded-xl bg-muted p-4">
      This scorecard needs JavaScript to run in your browser. Nothing is sent to a server.
    </p>
  </noscript>

  <section class="static-only mt-12 border-t border-border pt-6" aria-labelledby="how-title">
    <h2 id="how-title" class="mb-2 text-2xl font-bold">How it works</h2>
    <dl class="max-w-prose space-y-4">
      {
        [
          [
            "No AI, just rules",
            "Every answer maps to a fixed score from 0 to 3. Each question has a weight, and your score is the weighted share of the points available, per area and overall. The same answers always give the same result. Your biggest risks are the questions with the largest weighted gap to the best answer.",
          ],
          [
            "Private by design",
            "There are no accounts, cookies, analytics or third-party requests. Your answers stay in this browser (local storage, so you can resume) and are never uploaded. A result link contains your answers in the part of the URL after the #, which browsers do not send to servers.",
          ],
          [
            "What it is, and is not",
            "A quick, honest self-assessment that surfaces common gaps. It is not an audit: it cannot see your real system, so treat the output as a starting point for a conversation, not a verdict.",
          ],
        ].map(([term, text]) => (
          <div>
            <dt class="font-bold">{term}</dt>
            <dd class="mt-1 text-muted-foreground">{text}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>
